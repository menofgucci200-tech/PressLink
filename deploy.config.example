# Copiez ce fichier en "deploy.config" (à la racine du repo, à côté de
# deploy.sh) et remplissez vos vrais identifiants. deploy.config est
# ignoré par git (voir .gitignore) — ne le committez jamais.

# Accès SFTP LWS (le même compte que celui utilisé pour FTP/FileZilla).
# Attention : ce serveur n'autorise QUE le SFTP (pas de vrai shell), donc
# deploy.sh transfère des fichiers mais ne peut pas exécuter de commandes
# côté serveur (composer, artisan migrate, etc.) — voir les instructions
# affichées à la fin de chaque déploiement.
SSH_HOST=ftp.presslink.org
SSH_USER=press2855966
SSH_PASS=changeme

# Chemins absolus côté serveur (vus dans l'arborescence LWS).
REMOTE_API_DIR=/home/PressLink/presslink-api
REMOTE_APP_DIR=/home/PressLink/presslink-app
REMOTE_WEBROOT=/htdocs

# Optionnels (valeurs par défaut ci-dessous, à ne renseigner que pour changer).
# La PWA est publiée dans un sous-dossier du webroot : surtout pas le webroot lui-même.
# REMOTE_PWA_DIR=/htdocs/app
# PWA_URL=https://presslink.org/app/
# PWA_API_BASE_URL=https://presslink.org/api/v1
