# Assets de l'espace pressing et du site (Vite), servis sous /build/ — réglages Apache.
# Déployé par `./deploy.sh backend` (voir deploy.sh). Chaque fichier porte une
# empreinte dans son nom (app-B_KV07uf.css) : une nouvelle version change de nom,
# on peut donc le garder un an dans le navigateur sans jamais le revérifier.
# Chaque bloc est enveloppé dans <IfModule> : un module absent est ignoré (pas d'erreur 500).

<IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=31536000, immutable"
    <FilesMatch "\.json$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 year"
    ExpiresByType application/json "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
